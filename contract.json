{
  "apiVersion": "1.1",
  "formatVersion": 1,
  "runtimes": [
    "declarative",
    "preview-js",
    "hosted-js"
  ],
  "permissions": [
    "FILE_READ",
    "FILE_WRITE",
    "EDITOR_READ",
    "EDITOR_WRITE",
    "UI_ACCESS",
    "DIAGNOSTICS",
    "PROJECT_ACCESS",
    "NETWORK_ACCESS",
    "TERMINAL_ACCESS",
    "PROCESS_EXECUTION",
    "MEDIA_EXPORT",
    "SHARE",
    "DEVICE_FILES_READ",
    "DEVICE_FILES_WRITE"
  ],
  "supportedPermissions": [
    "FILE_READ",
    "FILE_WRITE",
    "EDITOR_READ",
    "EDITOR_WRITE",
    "UI_ACCESS",
    "DIAGNOSTICS",
    "NETWORK_ACCESS",
    "TERMINAL_ACCESS",
    "MEDIA_EXPORT",
    "SHARE",
    "DEVICE_FILES_READ",
    "DEVICE_FILES_WRITE"
  ],
  "officialOnlyPermissions": [
    "PROJECT_ACCESS"
  ],
  "reservedPermissions": [
    "PROCESS_EXECUTION"
  ],
  "maxPackageBytes": 104857600,
  "maxEntries": 2000,
  "maxManifestBytes": 524288,
  "maxUncompressedBytes": 314572800,
  "sourceFiles": [
    "ExtensionContract.kt",
    "ExtensionPackageValidator.kt",
    "IdeModels.kt",
    "HostedJsHarness.kt",
    "WorkspaceSearchLimits.kt",
    "WorkspaceSearchEngine.kt",
    "HostedWorkspaceSearchApi.kt"
  ],
  "features": {
    "workspaceSearch": {
      "since": "1.1",
      "permission": "FILE_READ",
      "methods": [
        "workspace.findFiles",
        "workspace.findText"
      ],
      "maxResults": 200,
      "defaultMaxResults": 100,
      "maxEntries": 20000,
      "defaultMaxEntries": 10000,
      "maxFileBytes": 1048576,
      "defaultMaxFileBytes": 262144,
      "maxTotalBytes": 16777216,
      "cooperativeBudgetMs": 5000,
      "maxConcurrentSearches": 2,
      "maxQueryLength": 256,
      "coordinates": "1-based line/column; 0-based UTF-16 offsets; exclusive end",
      "source": "saved UTF-8 files on disk"
    }
  }
}
