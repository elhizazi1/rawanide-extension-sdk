{
  "name": "@elhizazi1/extension-sdk",
  "version": "1.1.0",
  "private": false,
  "description": "Official RawanIDE Extension SDK CLI for building and validating .r1 extensions",
  "type": "module",
  "bin": {
    "rawanide-sdk": "bin/rawanide-sdk.mjs",
    "rawanide": "bin/rawanide-sdk.mjs",
    "rawanide-sdk-desktop": "bin/rawanide-sdk.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:package": "npm pack --dry-run --json",
    "check:types": "node --test tests/types.test.mjs",
    "check:release": "node bin/rawanide.mjs release-check",
    "check:types:compile": "tsc --noEmit --strict --skipLibCheck --target ES2020 tests/typing-smoke.ts",
    "check:archives": "node --test tests/archive-integration.test.mjs",
    "postinstall": "node scripts/fix-termux-bin.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "contract.json",
    "community-rules.json",
    "lib/",
    "templates/",
    "types/",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "scripts/"
  ],
  "types": "./types/rawanide.d.ts",
  "exports": {
    "./types": "./types/rawanide.d.ts",
    "./contract": "./contract.json",
    "./community-rules": "./community-rules.json"
  },
  "homepage": "https://github.com/elhizazi1/rawanide-extension-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elhizazi1/rawanide-extension-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/elhizazi1/rawanide-extension-sdk/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
