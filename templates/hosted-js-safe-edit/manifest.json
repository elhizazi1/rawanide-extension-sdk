  "commands": [
    {
      "id": "local.sdk-safe-edit.open",
      "title": "SDK Safe Edit: Open",
      "runtime": true,
      "hidden": true,
      "languages": [
        "*"
      ]
    }
  ],
  "contextActions": [
    {
      "id": "local.sdk-safe-edit.action",
      "title": "Preview safe replacement",
      "languages": [
        "*"
      ],
      "commandId": "local.sdk-safe-edit.open",
      "priority": 80,
      "icon": "assets/context-action.svg"
    }
  ],
  "icon": "assets/icon.svg",
  "license": "MIT"
}
